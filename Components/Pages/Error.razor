@page "/error"
@namespace AiCeo.Components.Pages

<PageTitle>Something went wrong</PageTitle>

<div class="shell">
    <main class="main">
        <div class="feed" style="align-items:center; justify-content:center;">
            <div class="empty-state">
                <div class="empty-mark">!</div>
                <h2>The orchestrator hit an unexpected error</h2>
                <p>Check the OmniRoute gateway is running at <code>http://localhost:20128/v1</code>, then reload.</p>
                <a class="btn primary" href="/" style="text-decoration:none">Back to the feed</a>
            </div>
        </div>
    </main>
</div>
