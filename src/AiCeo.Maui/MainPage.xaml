<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:AiCeo.Components;assembly=AiCeo.Maui"
             xmlns:local="clr-namespace:AiCeo.Maui"
             x:Class="AiCeo.Maui.MainPage"
             BackgroundColor="#080B11">

    <!-- The whole UI is the Blazor app, hosted inside a native WinUI window. -->
    <BlazorWebView HostPage="wwwroot/index.html" x:Name="BlazorHost">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type blazor:Main}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
