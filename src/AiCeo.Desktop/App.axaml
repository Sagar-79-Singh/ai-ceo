<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiCeo.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="#070A10" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#C9D6E6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EAF2FB" />
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#6E829C" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#647A94" />
        </Style>

        <Style Selector="TextBlock.tiny">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#5E7186" />
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#101825" />
            <Setter Property="BorderBrush" Value="#1C2635" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0F1622" />
            <Setter Property="BorderBrush" Value="#1C2635" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.agentcard">
            <Setter Property="Background" Value="#0D1520" />
            <Setter Property="BorderBrush" Value="#1A2434" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="#153A30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#16202E" />
            <Setter Property="Foreground" Value="#DCE7F5" />
            <Setter Property="BorderBrush" Value="#22303F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5EE0B0" />
            <Setter Property="Foreground" Value="#04140F" />
            <Setter Property="BorderBrush" Value="#5EE0B0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3A1B20" />
            <Setter Property="Foreground" Value="#FFB3B3" />
            <Setter Property="BorderBrush" Value="#5A2A31" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#131C29" />
            <Setter Property="Foreground" Value="#B8C8DB" />
            <Setter Property="BorderBrush" Value="#1E2836" />
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8EA3BD" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0A1017" />
            <Setter Property="Foreground" Value="#E4EDF8" />
            <Setter Property="BorderBrush" Value="#1E2A3A" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0A1017" />
            <Setter Property="Foreground" Value="#E4EDF8" />
            <Setter Property="BorderBrush" Value="#1E2A3A" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#A9BACD" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
