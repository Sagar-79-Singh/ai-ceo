<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiCeo.Desktop.App"
             RequestedThemeVariant="Dark">

    <!--
        Every colour and size below is a dynamic resource. Their values are written by
        ThemeManager from a ThemePalette (AiCeo.Core/Models/UiTheme.cs) whenever the user changes
        the theme, accent colour or text size — the Avalonia equivalent of CSS custom properties.
        The literal values here are only the pre-theme fallback.
    -->
    <Application.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#070A10" />
        <SolidColorBrush x:Key="SidebarBg" Color="#0B111A" />
        <SolidColorBrush x:Key="SidebarBorder" Color="#161F2E" />
        <SolidColorBrush x:Key="PanelBg" Color="#101825" />
        <SolidColorBrush x:Key="PanelBorder" Color="#1C2635" />
        <SolidColorBrush x:Key="CardBg" Color="#0F1622" />
        <SolidColorBrush x:Key="CardBorder" Color="#1C2635" />
        <SolidColorBrush x:Key="AgentCardBg" Color="#0D1520" />
        <SolidColorBrush x:Key="AgentCardBorder" Color="#1A2434" />
        <SolidColorBrush x:Key="FeedBg" Color="#080C13" />
        <SolidColorBrush x:Key="FeedBorder" Color="#151E2C" />
        <SolidColorBrush x:Key="ComposerBg" Color="#0D1420" />
        <SolidColorBrush x:Key="ComposerBorder" Color="#1B2635" />
        <SolidColorBrush x:Key="EditorBg" Color="#0E1622" />
        <SolidColorBrush x:Key="EditorBorder" Color="#23303F" />
        <SolidColorBrush x:Key="OverlayBg" Color="#C4000000" />
        <SolidColorBrush x:Key="InputBg" Color="#0A1017" />
        <SolidColorBrush x:Key="InputBorder" Color="#1E2A3A" />
        <SolidColorBrush x:Key="InputText" Color="#E4EDF8" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EAF2FB" />
        <SolidColorBrush x:Key="TextBody" Color="#C9D6E6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8EA3BD" />
        <SolidColorBrush x:Key="TextMuted" Color="#5E7186" />
        <SolidColorBrush x:Key="TextDim" Color="#48586C" />
        <SolidColorBrush x:Key="Accent" Color="#5EE0B0" />
        <SolidColorBrush x:Key="AccentOn" Color="#04140F" />
        <SolidColorBrush x:Key="AccentSoft" Color="#153A30" />
        <SolidColorBrush x:Key="AccentSoftText" Color="#5EE0B0" />
        <SolidColorBrush x:Key="AccentBorder" Color="#1D4A44" />
        <SolidColorBrush x:Key="Ok" Color="#5EE0B0" />
        <SolidColorBrush x:Key="Warn" Color="#FFC46B" />
        <SolidColorBrush x:Key="Danger" Color="#FF9A9A" />
        <SolidColorBrush x:Key="DangerBg" Color="#2A1417" />
        <SolidColorBrush x:Key="DangerBorder" Color="#5A2A31" />
        <SolidColorBrush x:Key="ToolBg" Color="#0D1522" />
        <SolidColorBrush x:Key="ToolBorder" Color="#22304A" />
        <SolidColorBrush x:Key="ToolAccent" Color="#9AA8FF" />
        <SolidColorBrush x:Key="UserBubbleBg" Color="#14243A" />
        <SolidColorBrush x:Key="UserBubbleBorder" Color="#20354F" />
        <SolidColorBrush x:Key="FinalBg" Color="#0E1B1A" />
        <SolidColorBrush x:Key="FinalBorder" Color="#1D4A44" />
        <SolidColorBrush x:Key="BannerInfoBg" Color="#0F2430" />
        <SolidColorBrush x:Key="BannerInfoBorder" Color="#1D4A56" />
        <SolidColorBrush x:Key="BannerErrorBg" Color="#2A1417" />
        <SolidColorBrush x:Key="BannerErrorBorder" Color="#5A2A31" />
        <SolidColorBrush x:Key="BadgeCeoBg" Color="#153A30" />
        <SolidColorBrush x:Key="BadgeToolsBg" Color="#1B2436" />
        <SolidColorBrush x:Key="BrandTileBg" Color="#123A33" />
        <SolidColorBrush x:Key="StepIndexBg" Color="#17222F" />
        <SolidColorBrush x:Key="ButtonBg" Color="#16202E" />
        <SolidColorBrush x:Key="ButtonBorder" Color="#22303F" />
        <SolidColorBrush x:Key="ButtonText" Color="#DCE7F5" />

        <x:Double x:Key="FontBase">13</x:Double>
        <x:Double x:Key="FontTitle">19</x:Double>
        <x:Double x:Key="FontSubtitle">11.5</x:Double>
        <x:Double x:Key="FontLabel">10</x:Double>
        <x:Double x:Key="FontTiny">10.5</x:Double>
        <x:Double x:Key="FontMono">11</x:Double>
        <x:Double x:Key="FontBody">12.5</x:Double>
        <x:Double x:Key="FontButton">12</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{DynamicResource FontLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style Selector="TextBlock.tiny">
            <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource FontMono}" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.agentcard">
            <Setter Property="Background" Value="{DynamicResource AgentCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AgentCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontButton}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentOn}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <!-- the settings gear in the header -->
        <Style Selector="Button.gear">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.gear:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
        </Style>

        <!-- theme cards in the settings panel -->
        <Style Selector="Button.themecard">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Button.themecard.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- accent swatches -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#07100C" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource InputText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource InputText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource InputBorder}" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </Application.Styles>
</Application>
