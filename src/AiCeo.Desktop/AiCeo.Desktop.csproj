<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- True cross-platform desktop: the same assembly runs on Windows, Linux and macOS. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiCeo.Desktop</RootNamespace>
    <AssemblyName>AiCeo</AssemblyName>

    <Product>AI CEO Orchestrator</Product>
    <Description>Star-topology AI orchestrator with a local workspace and tool-using agents.</Description>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>

    <!-- The icon shown in Explorer/taskbar. Windows-only; ignored by the other targets. PhotinoX
         also picks it up for the native window, so no window-icon plumbing is needed. -->
    <ApplicationIcon>Assets/aiceo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Shipping as one file on machines without ICU installed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Single-file, self-contained shipping settings.

    These live in the project file (not only on the CI command line) so a local `dotnet publish -r
    <rid>` produces exactly the artefact the installers package. IncludeNativeLibrariesForSelfExtract
    matters most: PhotinoX.Native (PhotinoX.Native.dll / .so / .dylib, plus WebView2Loader.dll on
    Windows) is extracted to a temp folder at run time and resolved from there. Without it the
    bundle cannot find its own native library, which is exactly the class of failure that shows up
    as "the portable build runs but the installed build does nothing".

    They are conditioned on a RuntimeIdentifier because the SDK rejects a self-contained build
    without one (NETSDK1031), and `dotnet build` / `dotnet test` on the solution must keep working.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!--
    v1.0.15: PhotinoX is the entire UI stack. It is a thin .NET wrapper around the WebView the OS
    already ships — WebView2 on Windows, WKWebView on macOS, WebKitGTK 4.1 on Linux — so there is no
    XAML, no managed renderer and no compositor between the window and the page. That is what
    removes the invisible-window and start-up-freeze class of bug for good.

    Version 5.3.5 is the current published line (PhotinoX.Native 5.3.5 ships the per-RID native
    library for win-x64/win-arm64/linux-x64/linux-arm64/osx-x64/osx-arm64).
  -->
  <ItemGroup>
    <PackageReference Include="PhotinoX" Version="5.3.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiCeo.Core\AiCeo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Nexus shell ships inside the assembly. Only the page and its compiled stylesheet are
         embedded: NexusAssets reads them from the manifest resource stream, inlines the stylesheet
         into the document and hands the result to the native WebView. Nothing is written to disk
         and no file:// access is required, which is what keeps the surface identical on all three
         engines. aiceo.ico is used by <ApplicationIcon> above (and by the installer). -->
    <EmbeddedResource Include="Assets\nexus.html" />
    <EmbeddedResource Include="Assets\nexus.css" />
  </ItemGroup>

</Project>
