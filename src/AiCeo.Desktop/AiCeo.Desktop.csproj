<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- True cross-platform desktop: the same assembly runs on Windows, Linux and macOS. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiCeo.Desktop</RootNamespace>
    <AssemblyName>AiCeo</AssemblyName>

    <Product>AI CEO Orchestrator</Product>
    <Description>Star-topology AI orchestrator with a local workspace and tool-using agents.</Description>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>

    <!-- The icon shown in Explorer/taskbar. Windows-only; ignored by the other targets. -->
    <ApplicationIcon>Assets/aiceo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Reflection bindings: no compile-time x:DataType requirements in the views. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Shipping as one file on machines without ICU installed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiCeo.Core\AiCeo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
