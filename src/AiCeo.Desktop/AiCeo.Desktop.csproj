<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- True cross-platform desktop: the same assembly runs on Windows, Linux and macOS. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiCeo.Desktop</RootNamespace>
    <AssemblyName>AiCeo</AssemblyName>

    <Product>AI CEO Orchestrator</Product>
    <Description>Star-topology AI orchestrator with a local workspace and tool-using agents.</Description>
    <Version>1.0.13</Version>
    <AssemblyVersion>1.0.13.0</AssemblyVersion>
    <FileVersion>1.0.13.0</FileVersion>

    <!-- The icon shown in Explorer/taskbar. Windows-only; ignored by the other targets. -->
    <ApplicationIcon>Assets/aiceo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Reflection bindings: no compile-time x:DataType requirements in the views. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Shipping as one file on machines without ICU installed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Single-file, self-contained shipping settings.

    These live in the project file (not only on the CI command line) so a local `dotnet publish -r
    <rid>` produces exactly the artefact the installers package. IncludeNativeLibrariesForSelfExtract
    matters most: Avalonia's native payload — libSkiaSharp, libHarfBuzzSharp, the WebView2 loader and
    friends — is extracted to a temp folder at run time and resolved from there. Without it the
    bundle cannot find its own native libraries, which is exactly the class of failure that shows up
    as "the portable build runs but the installed build does nothing".

    They are conditioned on a RuntimeIdentifier because the SDK rejects a self-contained build
    without one (NETSDK1031), and `dotnet build` / `dotnet test` on the solution must keep working.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Native web surface for the Nexus shell. 11.4.1 is the Avalonia 11 line (12.x needs Avalonia 12). -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiCeo.Core\AiCeo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything in Assets/ (nexus.html, nexus.css, theme.css, aiceo.png) ships as an avares://
         resource. The icon is listed separately so it is unambiguous that aiceo.ico — used by both
         <ApplicationIcon> for the .exe and Icon="avares://AiCeo/Assets/aiceo.ico" for the window —
         is embedded; it is excluded from the glob to avoid a duplicate item. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\aiceo.ico" />
    <AvaloniaResource Include="Assets\aiceo.ico" />
  </ItemGroup>

</Project>
