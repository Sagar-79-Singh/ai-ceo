<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AiCeo.Desktop.Views.NexusWindow"
        Title="AI CEO Orchestrator — NEXUS"
        Width="1480"
        Height="940"
        MinWidth="1120"
        MinHeight="700"
        Background="#07080B"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Icon="avares://AiCeo/Assets/aiceo.ico"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="False">

    <!--
        The visible interface is the HTML shell (Assets/nexus.html) rendered by the platform web
        engine. This XAML only hosts it and draws the fallback panel used when the engine cannot
        start (the app then offers the native Avalonia shell instead).
    -->
    <Grid>
        <NativeWebView x:Name="Surface"
                       NavigationCompleted="OnNavigationCompleted"
                       WebMessageReceived="OnWebMessageReceived" />

        <Border x:Name="FallbackPanel"
                IsVisible="False"
                Background="#0C0D12"
                Padding="48">
            <StackPanel MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="NEXUS surface unavailable"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#F1F5F9" />
                <TextBlock x:Name="FallbackReason"
                           TextWrapping="Wrap"
                           Foreground="#94A3B8"
                           FontSize="13" />
                <TextBlock Text="The orchestrator, your agents and the workspace sandbox are unaffected — only the rendered shell is missing."
                           TextWrapping="Wrap"
                           Foreground="#64748B"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button x:Name="ClassicButton"
                            Content="Use the classic interface"
                            Click="OnClassicClicked"
                            Background="#10B981"
                            Foreground="#04140F"
                            Padding="18,9" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Click="OnCloseClicked"
                            Background="#1D212D"
                            Foreground="#E2E8F0"
                            Padding="18,9" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
