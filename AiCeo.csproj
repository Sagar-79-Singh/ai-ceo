<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiCeo</RootNamespace>
    <AssemblyName>AiCeo</AssemblyName>
    <Product>AI CEO Orchestrator</Product>
    <Description>Star-topology AI orchestrator powered by a local OmniRoute gateway.</Description>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <!--
    A single-file publish leaves wwwroot (which holds _framework/blazor.web.js) as loose files
    next to the exe. Embed those framework assets so a lone AiCeo.exe still serves the Blazor
    client script (FrameworkAssetStore maps /_framework/* to these resources). When wwwroot is
    present, UseStaticFiles serves the on-disk copy first; the embedded copy is the fallback.
  -->
  <Target Name="EmbedFrameworkStaticAssets"
          AfterTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="ResolveStaticWebAssetsInputs"
          BeforeTargets="PrepareResourceNames;CoreCompile">
    <ItemGroup>
      <_FrameworkStaticAssetRaw Include="@(StaticWebAsset)"
                                Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('_framework/')) AND '%(AssetRole)' != 'Alternative'" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_FrameworkStaticAssetRaw)">
      <Output TaskParameter="Filtered" ItemName="_FrameworkStaticAsset" />
    </RemoveDuplicates>

    <PropertyGroup>
      <_FrameworkStaticAssetCount>@(_FrameworkStaticAsset->Count())</_FrameworkStaticAssetCount>
    </PropertyGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)fwa-diag.txt"
                      Lines="matched=$(_FrameworkStaticAssetCount)"
                      Overwrite="true" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)fwa-diag.txt"
                      Lines="%(_FrameworkStaticAsset.RelativePath) => %(_FrameworkStaticAsset.FullPath)"
                      Overwrite="false" />

    <Error Condition="'@(_FrameworkStaticAsset)' == ''"
           Text="No _framework/* static web assets were found to embed. The single-file build needs them for the Blazor client script." />

    <ItemGroup>
      <EmbeddedResource Include="@(_FrameworkStaticAsset->'%(FullPath)')"
                        LogicalName="AiCeo.FrameworkAssets.%(RelativePath)"
                        Visible="false" />
    </ItemGroup>

    <Message Importance="high" Text="Embedding framework asset: %(_FrameworkStaticAsset.RelativePath)" />
  </Target>

</Project>
