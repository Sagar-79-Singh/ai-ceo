<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiCeo</RootNamespace>
    <AssemblyName>AiCeo</AssemblyName>
    <Product>AI CEO Orchestrator</Product>
    <Description>Star-topology AI orchestrator powered by a local OmniRoute gateway.</Description>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <!--
    A single-file publish keeps wwwroot (which holds _framework/blazor.web.js) as loose files
    beside the exe. Embed the Blazor client scripts instead so a lone AiCeo.exe can serve them
    (FrameworkAssetStore maps /_framework/* onto these resources). When wwwroot is present,
    UseStaticFiles serves the on-disk copy first and the embedded copy is only a fallback.

    The files live in the NuGet cache (microsoft.aspnetcore.app.internal.assets). Embedding them
    at evaluation time keeps the resource list complete before the compiler names resources, and
    the version stays in the logical name so several cached SDK versions can never collide.
  -->
  <ItemGroup>
    <_BlazorClientScript Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/*/_framework/blazor.web.js"
                         Condition="'$(NuGetPackageRoot)' != ''" />
    <_BlazorClientScript Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/*/_framework/blazor.server.js"
                         Condition="'$(NuGetPackageRoot)' != ''" />
    <EmbeddedResource Include="@(_BlazorClientScript)"
                      LogicalName="AiCeo.FrameworkAssets.%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

  <Target Name="WarnIfBlazorScriptMissing" BeforeTargets="CoreCompile">
    <Warning Condition="'@(_BlazorClientScript)' == ''"
             Text="Could not find _framework/blazor.web.js in the NuGet cache. A single-file .exe will then need the wwwroot folder beside it." />
  </Target>

</Project>
